
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Picture Vault</title>

<style>
:root {
    --bg: #0b1020;
    --panel: #141c30;
    --panel2: #1b2740;
    --text: #eef3ff;
    --muted: #9aa8c4;
    --accent: #7c5cff;
    --accent2: #27d7b5;
    --danger: #ff5577;
    --border: #2b3855;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
}

button, input {
    font: inherit;
}

button {
    border: 0;
    border-radius: 10px;
    padding: 10px 14px;
    color: white;
    background: var(--accent);
    cursor: pointer;
    transition: 0.15s;
}

button:hover {
    filter: brightness(1.15);
}

button:disabled {
    opacity: 0.55;
    cursor: wait;
}

button.secondary {
    background: var(--panel2);
    border: 1px solid var(--border);
}

button.danger {
    background: #8e2943;
}

button.green {
    background: #087e70;
}

input {
    width: 100%;
    padding: 12px;
    border-radius: 10px;
    background: #0d1425;
    border: 1px solid var(--border);
    color: white;
    outline: none;
}

input:focus {
    border-color: var(--accent);
}

header {
    padding: 20px;
    border-bottom: 1px solid var(--border);
    background: #10182b;
    position: sticky;
    top: 0;
    z-index: 5;
}

.header-inner {
    max-width: 1250px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
}

.logo {
    font-size: 23px;
    font-weight: 800;
}

.logo span {
    color: var(--accent2);
}

main {
    max-width: 1250px;
    margin: auto;
    padding: 22px;
}

h1, h2, h3 {
    margin-top: 0;
}

.subtitle {
    color: var(--muted);
    line-height: 1.5;
}

.tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 22px 0;
}

.tab-button.active {
    background: var(--accent2);
    color: #061b1b;
    font-weight: bold;
}

.tab {
    display: none;
}

.tab.active {
    display: block;
}

.panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 20px;
}

.upload-area {
    border: 2px dashed #45547a;
    padding: 35px 15px;
    border-radius: 14px;
    text-align: center;
    cursor: pointer;
    background: #10192c;
}

.upload-area.dragging {
    border-color: var(--accent2);
    background: #132d34;
}

.upload-area p {
    color: var(--muted);
}

.row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
}

.row > input {
    flex: 1;
    min-width: 180px;
}

.searchbar {
    margin-bottom: 18px;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
    gap: 15px;
}

.image-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 13px;
    overflow: hidden;
    min-width: 0;
}

.image-card img {
    width: 100%;
    height: 175px;
    display: block;
    object-fit: cover;
    background: #080c16;
    cursor: pointer;
}

.image-info {
    padding: 12px;
}

.image-name {
    font-weight: bold;
    overflow-wrap: anywhere;
    margin-bottom: 6px;
}

.image-date {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 10px;
}

.card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.card-actions button {
    font-size: 12px;
    padding: 8px 9px;
}

.empty {
    text-align: center;
    padding: 35px;
    color: var(--muted);
    border: 1px dashed var(--border);
    border-radius: 14px;
}

.status {
    margin-top: 12px;
    color: var(--muted);
    min-height: 20px;
    overflow-wrap: anywhere;
}

.ai-layout {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(260px, 1fr);
    gap: 20px;
}

.ai-preview {
    width: 100%;
    min-height: 240px;
    max-height: 520px;
    object-fit: contain;
    background: #080c16;
    border: 1px solid var(--border);
    border-radius: 12px;
    display: none;
}

.preview-placeholder {
    min-height: 240px;
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--muted);
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 20px;
}

.small {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    z-index: 20;
    padding: 20px;
    align-items: center;
    justify-content: center;
}

.modal.open {
    display: flex;
}

.modal-content {
    width: min(1000px, 100%);
    max-height: 95vh;
    overflow: auto;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 15px;
}

.modal-image {
    width: 100%;
    max-height: 75vh;
    object-fit: contain;
    display: block;
    margin-bottom: 12px;
}

.modal-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
}

#toast {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: #243451;
    border: 1px solid #506184;
    padding: 12px 18px;
    border-radius: 12px;
    z-index: 50;
    display: none;
    max-width: calc(100% - 30px);
    text-align: center;
}

footer {
    text-align: center;
    color: var(--muted);
    padding: 25px;
    font-size: 12px;
}

@media (max-width: 720px) {
    main {
        padding: 14px;
    }

    .ai-layout {
        grid-template-columns: 1fr;
    }

    .gallery {
        grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
    }

    .image-card img {
        height: 145px;
    }
}
</style>
</head>

<body>

<header>
    <div class="header-inner">
        <div class="logo">🖼️ Picture <span>Vault</span></div>
        <div id="imageCount" class="subtitle">0 pictures</div>
    </div>
</header>

<main>
    <h1>Your personal picture vault</h1>
    <p class="subtitle">
        Upload pictures, create AI images, and organize your private collection.
    </p>

    <div class="tabs">
        <button class="tab-button active" data-tab="galleryTab">🖼️ Gallery</button>
        <button class="tab-button" data-tab="uploadTab">⬆️ Upload</button>
        <button class="tab-button" data-tab="aiTab">✨ AI Creator</button>
        <button class="tab-button" data-tab="secretTab">🔒 Secret Vault</button>
    </div>

    <!-- GALLERY -->
    <section id="galleryTab" class="tab active">
        <div class="panel">
            <h2>Your Pictures</h2>
            <input
                id="searchInput"
                class="searchbar"
                type="search"
                placeholder="Search your pictures..."
            >

            <div class="row">
                <button class="secondary" id="showAllBtn">Show All</button>
                <button class="secondary" id="showHiddenBtn">Show Hidden</button>
            </div>
        </div>

        <div id="gallery" class="gallery"></div>
        <div id="galleryEmpty" class="empty" style="display:none;">
            No pictures found. Upload a picture or create one with the AI Creator.
        </div>
    </section>

    <!-- UPLOAD -->
    <section id="uploadTab" class="tab">
        <div class="panel">
            <h2>Upload Pictures</h2>
            <p class="subtitle">Choose images or drag them into the area below.</p>

            <div id="dropArea" class="upload-area">
                <h3>📁 Drop pictures here</h3>
                <p>Or click here to select files from your computer.</p>
                <button type="button" id="chooseFilesBtn">Choose Pictures</button>
                <input
                    id="fileInput"
                    type="file"
                    accept="image/*"
                    multiple
                    hidden
                >
            </div>

            <div id="uploadStatus" class="status"></div>
        </div>
    </section>

    <!-- AI CREATOR -->
    <section id="aiTab" class="tab">
        <div class="panel">
            <h2>✨ AI Photo Creator</h2>
            <p class="subtitle">
                Describe an image and generate a picture from your prompt.
            </p>

            <div class="ai-layout">
                <div>
                    <label for="aiPrompt">What picture do you want?</label>
                    <input
                        id="aiPrompt"
                        type="text"
                        placeholder="A futuristic city at sunset..."
                    >

                    <div style="height:12px"></div>

                    <button id="generateAI" type="button">
                        ✨ Generate Image
                    </button>

                    <button id="saveAI" type="button" class="green" disabled>
                        💾 Save to Gallery
                    </button>

                    <p class="small">
                        Be descriptive. For example: “A cute orange cat wearing
                        a space helmet, colorful digital art.”
                    </p>

                    <div id="aiStatus" class="status"></div>
                </div>

                <div>
                    <div id="aiPlaceholder" class="preview-placeholder">
                        Your generated picture will appear here.
                    </div>

                    <img
                        id="aiPreview"
                        class="ai-preview"
                        alt="AI-generated preview"
                    >
                </div>
            </div>
        </div>

        <div class="panel">
            <h3>AI generation troubleshooting</h3>
            <p class="small">
                This version loads the image directly into the preview instead
                of relying on a browser fetch to display it. The image service
                is external, so generation can still fail if that service is
                unavailable. Saving may also fail if the service blocks
                cross-origin downloads.
            </p>
        </div>
    </section>

    <!-- SECRET VAULT -->
    <section id="secretTab" class="tab">
        <div class="panel">
            <h2>🔒 Secret Vault</h2>
            <p class="subtitle">
                Hide pictures from your normal gallery and keep them in this
                separate view.
            </p>

            <div id="secretSetup">
                <h3>Create a vault passcode</h3>
                <input
                    id="newPasscode"
                    type="password"
                    inputmode="numeric"
                    placeholder="Create a passcode"
                >
                <div style="height:10px"></div>
                <input
                    id="confirmPasscode"
                    type="password"
                    inputmode="numeric"
                    placeholder="Confirm your passcode"
                >
                <div style="height:10px"></div>
                <button id="createVaultBtn">Create Secret Vault</button>
            </div>

            <div id="secretUnlock" style="display:none;">
                <h3>Unlock your vault</h3>
                <input
                    id="vaultPasscode"
                    type="password"
                    inputmode="numeric"
                    placeholder="Enter your passcode"
                >
                <div style="height:10px"></div>
                <button id="unlockVaultBtn">Unlock Vault</button>
            </div>

            <div id="secretContent" style="display:none;">
                <div class="row">
                    <h3 style="margin:0;">Hidden Pictures</h3>
                    <button id="lockVaultBtn" class="secondary">Lock Vault</button>
                </div>
                <p class="small">
                    Select “Unhide” on a picture to return it to the main gallery.
                </p>
                <div id="secretGallery" class="gallery"></div>
                <div id="secretEmpty" class="empty" style="display:none;">
                    There are no hidden pictures.
                </div>
            </div>

            <div id="secretStatus" class="status"></div>
        </div>
    </section>
</main>

<!-- IMAGE VIEWER -->
<div id="viewer" class="modal">
    <div class="modal-content">
        <div class="modal-top">
            <strong id="viewerTitle">Picture</strong>
            <button id="closeViewer" class="secondary">✕ Close</button>
        </div>
        <img id="viewerImage" class="modal-image" alt="Picture preview">
        <div class="row">
            <button id="viewerDownload">Download</button>
            <button id="viewerHide" class="secondary">Hide Picture</button>
        </div>
    </div>
</div>

<div id="toast"></div>

<footer>
    Picture Vault · Images are stored in this browser on this device.
</footer>

<script>
"use strict";

/* =========================================================
   DATABASE
   ========================================================= */

const DB_NAME = "PictureVaultDatabase";
const DB_VERSION = 1;
const STORE_NAME = "pictures";

let db;
let pictures = [];
let currentFilter = "all";
let vaultUnlocked = false;
let currentViewerId = null;
let currentAIUrl = null;
let currentAIBlob = null;

function openDatabase() {
    return new Promise((resolve, reject) => {
        const request = indexedDB.open(DB_NAME, DB_VERSION);

        request.onupgradeneeded = () => {
            const database = request.result;

            if (!database.objectStoreNames.contains(STORE_NAME)) {
                const store = database.createObjectStore(STORE_NAME, {
                    keyPath: "id",
                    autoIncrement: true
                });

                store.createIndex("hidden", "hidden", { unique: false });
            }
        };

        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
    });
}

function storeTransaction(mode = "readonly") {
    return db.transaction(STORE_NAME, mode).objectStore(STORE_NAME);
}

function getAllPictures() {
    return new Promise((resolve, reject) => {
        const request = storeTransaction().getAll();
        request.onsuccess = () => resolve(request.result || []);
        request.onerror = () => reject(request.error);
    });
}

function addPicture(picture) {
    return new Promise((resolve, reject) => {
        const request = storeTransaction("readwrite").add(picture);
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
    });
}

function updatePicture(id, changes) {
    return new Promise(async (resolve, reject) => {
        try {
            const transaction = db.transaction(STORE_NAME, "readwrite");
            const store = transaction.objectStore(STORE_NAME);
            const request = store.get(id);

            request.onsuccess = () => {
                const item = request.result;

                if (!item) {
                    reject(new Error("Picture not found."));
                    return;
                }

                Object.assign(item, changes);
                store.put(item);
            };

            request.onerror = () => reject(request.error);
            transaction.oncomplete = () => resolve();
            transaction.onerror = () => reject(transaction.error);
        } catch (error) {
            reject(error);
        }
    });
}

function deletePicture(id) {
    return new Promise((resolve, reject) => {
        const request = storeTransaction("readwrite").delete(id);
        request.onsuccess = () => resolve();
        request.onerror = () => reject(request.error);
    });
}

/* =========================================================
   GENERAL HELPERS
   ========================================================= */

const $ = id => document.getElementById(id);

function toast(message) {
    const element = $("toast");
    element.textContent = message;
    element.style.display = "block";

    clearTimeout(toast.timeout);
    toast.timeout = setTimeout(() => {
        element.style.display = "none";
    }, 3000);
}

function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
    })[character]);
}

function formatDate(timestamp) {
    return new Date(timestamp).toLocaleString();
}

function makeObjectURL(blob) {
    return URL.createObjectURL(blob);
}

function downloadBlob(blob, filename) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = filename || "picture";
    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(() => URL.revokeObjectURL(url), 1500);
}

function downloadPicture(picture) {
    downloadBlob(picture.blob, picture.name);
}

async function refreshPictures() {
    pictures = await getAllPictures();
    $("imageCount").textContent =
        pictures.length + (pictures.length === 1 ? " picture" : " pictures");

    renderGallery();
    renderSecretGallery();
}

/* =========================================================
   TABS
   ========================================================= */

document.querySelectorAll(".tab-button").forEach(button => {
    button.addEventListener("click", () => {
        document.querySelectorAll(".tab-button").forEach(item =>
            item.classList.remove("active")
        );

        document.querySelectorAll(".tab").forEach(item =>
            item.classList.remove("active")
        );

        button.classList.add("active");
        $(button.dataset.tab).classList.add("active");

        if (button.dataset.tab === "secretTab") {
            updateSecretPanel();
        }
    });
});

/* =========================================================
   UPLOAD AND DRAG-AND-DROP
   ========================================================= */

$("chooseFilesBtn").addEventListener("click", () => {
    $("fileInput").click();
});

$("dropArea").addEventListener("click", event => {
    if (event.target.id !== "chooseFilesBtn") {
        $("fileInput").click();
    }
});

$("fileInput").addEventListener("change", async event => {
    await handleFiles(event.target.files);
    event.target.value = "";
});

["dragenter", "dragover"].forEach(eventName => {
    $("dropArea").addEventListener(eventName, event => {
        event.preventDefault();
        $("dropArea").classList.add("dragging");
    });
});

["dragleave", "drop"].forEach(eventName => {
    $("dropArea").addEventListener(eventName, event => {
        event.preventDefault();
        $("dropArea").classList.remove("dragging");
    });
});

$("dropArea").addEventListener("drop", async event => {
    await handleFiles(event.dataTransfer.files);
});

async function handleFiles(fileList) {
    const files = Array.from(fileList).filter(file =>
        file.type.startsWith("image/")
    );

    if (!files.length) {
        $("uploadStatus").textContent = "Please select image files.";
        return;
    }

    let saved = 0;
    $("uploadStatus").textContent = "Uploading pictures...";

    for (const file of files) {
        try {
            await addPicture({
                name: file.name,
                blob: file,
                type: file.type,
                createdAt: Date.now(),
                hidden: false,
                source: "upload"
            });

            saved++;
        } catch (error) {
            console.error(error);
        }
    }

    $("uploadStatus").textContent =
        "Uploaded " + saved + " of " + files.length + " picture(s).";

    await refreshPictures();
    toast(saved + " picture(s) added.");
}

/* =========================================================
   GALLERY RENDERING
   ========================================================= */

$("searchInput").addEventListener("input", renderGallery);

$("showAllBtn").addEventListener("click", () => {
    currentFilter = "all";
    renderGallery();
});

$("showHiddenBtn").addEventListener("click", () => {
    currentFilter = "hidden";
    renderGallery();
});

function renderGallery() {
    const gallery = $("gallery");
    const search = $("searchInput").value.trim().toLowerCase();

    let visible = pictures.filter(picture => {
        const matchesSearch = (picture.name || "").toLowerCase().includes(search);

        if (currentFilter === "hidden") {
            return picture.hidden && matchesSearch;
        }

        return !picture.hidden && matchesSearch;
    });

    gallery.innerHTML = "";

    $("galleryEmpty").style.display = visible.length ? "none" : "block";

    visible.sort((a, b) => b.createdAt - a.createdAt);

    visible.forEach(picture => {
        gallery.appendChild(createPictureCard(picture, false));
    });
}

function renderSecretGallery() {
    const gallery = $("secretGallery");

    if (!vaultUnlocked) {
        gallery.innerHTML = "";
        $("secretEmpty").style.display = "none";
        return;
    }

    const hiddenPictures = pictures
        .filter(picture => picture.hidden)
        .sort((a, b) => b.createdAt - a.createdAt);

    gallery.innerHTML = "";
    $("secretEmpty").style.display = hiddenPictures.length ? "none" : "block";

    hiddenPictures.forEach(picture => {
        gallery.appendChild(createPictureCard(picture, true));
    });
}

function createPictureCard(picture, isSecret) {
    const card = document.createElement("article");
    card.className = "image-card";

    const image = document.createElement("img");
    image.alt = picture.name || "Picture";
    image.loading = "lazy";

    const imageURL = makeObjectURL(picture.blob);
    image.src = imageURL;
    image.addEventListener("load", () => URL.revokeObjectURL(imageURL), {
        once: true
    });

    image.addEventListener("error", () => URL.revokeObjectURL(imageURL), {
        once: true
    });

    image.addEventListener("click", () => openViewer(picture.id));

    const info = document.createElement("div");
    info.className = "image-info";

    const name = document.createElement("div");
    name.className = "image-name";
    name.textContent = picture.name || "Untitled picture";

    const date = document.createElement("div");
    date.className = "image-date";
    date.textContent = formatDate(picture.createdAt);

    const actions = document.createElement("div");
    actions.className = "card-actions";

    const viewButton = document.createElement("button");
    viewButton.textContent = "View";
    viewButton.addEventListener("click", () => openViewer(picture.id));

    const downloadButton = document.createElement("button");
    downloadButton.className = "secondary";
    downloadButton.textContent = "Download";
    downloadButton.addEventListener("click", () => downloadPicture(picture));

    const hideButton = document.createElement("button");
    hideButton.className = "secondary";
    hideButton.textContent = isSecret ? "Unhide" : "Hide";
    hideButton.addEventListener("click", async () => {
        if (isSecret) {
            await updatePicture(picture.id, { hidden: false });
            await refreshPictures();
            toast("Picture returned to the main gallery.");
        } else {
            await updatePicture(picture.id, { hidden: true });
            await refreshPictures();
            toast("Picture moved to the Secret Vault.");
        }
    });

    const deleteButton = document.createElement("button");
    deleteButton.className = "danger";
    deleteButton.textContent = "Delete";
    deleteButton.addEventListener("click", async () => {
        const confirmed = confirm(
            "Permanently delete '" + (picture.name || "this picture") + "'?"
        );

        if (!confirmed) return;

        await deletePicture(picture.id);
        await refreshPictures();
        toast("Picture deleted.");
    });

    actions.append(viewButton, downloadButton, hideButton, deleteButton);
    info.append(name, date, actions);
    card.append(image, info);

    return card;
}

/* =========================================================
   IMAGE VIEWER
   ========================================================= */

function openViewer(id) {
    const picture = pictures.find(item => item.id === id);
    if (!picture) return;

    currentViewerId = id;

    $("viewerTitle").textContent = picture.name || "Picture";

    const oldURL = $("viewerImage").dataset.objectURL;
    if (oldURL) URL.revokeObjectURL(oldURL);

    const url = makeObjectURL(picture.blob);
    $("viewerImage").src = url;
    $("viewerImage").dataset.objectURL = url;

    $("viewer").classList.add("open");
    $("viewerHide").textContent = picture.hidden ? "Unhide Picture" : "Hide Picture";
}

function closeViewer() {
    $("viewer").classList.remove("open");
    $("viewerImage").removeAttribute("src");

    const url = $("viewerImage").dataset.objectURL;
    if (url) URL.revokeObjectURL(url);

    delete $("viewerImage").dataset.objectURL;
    currentViewerId = null;
}

$("closeViewer").addEventListener("click", closeViewer);

$("viewer").addEventListener("click", event => {
    if (event.target === $("viewer")) closeViewer();
});

document.addEventListener("keydown", event => {
    if (event.key === "Escape") closeViewer();
});

$("viewerDownload").addEventListener("click", () => {
    const picture = pictures.find(item => item.id === currentViewerId);
    if (picture) downloadPicture(picture);
});

$("viewerHide").addEventListener("click", async () => {
    const picture = pictures.find(item => item.id === currentViewerId);
    if (!picture) return;

    if (picture.hidden && !vaultUnlocked) {
        toast("Unlock the Secret Vault before unhiding this picture.");
        return;
    }

    await updatePicture(picture.id, { hidden: !picture.hidden });
    await refreshPictures();
    closeViewer();
    toast(picture.hidden ? "Picture unhidden." : "Picture hidden.");
});

/* =========================================================
   AI IMAGE GENERATOR
   ========================================================= */

/*
    This version sets the generated image URL directly on the preview.
    That avoids requiring fetch() just to DISPLAY the image.

    The remote service can change or be unavailable. If that happens,
    the page cannot force the service to generate an image.
*/

$("generateAI").addEventListener("click", generateAI);

$("aiPrompt").addEventListener("keydown", event => {
    if (event.key === "Enter") generateAI();
});

$("saveAI").addEventListener("click", saveAIImage);

function setAIStatus(message) {
    $("aiStatus").textContent = message;
}

function generateAI() {
    const prompt = $("aiPrompt").value.trim();

    if (!prompt) {
        setAIStatus("Enter a description for your picture first.");
        $("aiPrompt").focus();
        return;
    }

    const button = $("generateAI");
    const preview = $("aiPreview");

    button.disabled = true;
    button.textContent = "Generating...";
    $("saveAI").disabled = true;
    $("aiPlaceholder").style.display = "grid";
    $("aiPlaceholder").textContent = "Generating your picture...";

    preview.style.display = "none";
    preview.removeAttribute("src");

    currentAIUrl = null;
    currentAIBlob = null;

    /*
       A new seed requests a different result on each generation.
       The prompt is encoded so spaces and punctuation work in the URL.
    */
    const seed = Math.floor(Math.random() * 2147483647);

    const imageURL =
        "https://image.pollinations.ai/prompt/" +
        encodeURIComponent(prompt) +
        "?width=1024&height=1024&seed=" + seed +
        "&nologo=true";

    currentAIUrl = imageURL;

    preview.onload = () => {
        button.disabled = false;
        button.textContent = "✨ Generate Image";

        preview.style.display = "block";
        $("aiPlaceholder").style.display = "none";
        $("saveAI").disabled = false;

        setAIStatus(
            "Image generated. Click “Save to Gallery” to try saving it."
        );
    };

    preview.onerror = () => {
        button.disabled = false;
        button.textContent = "✨ Generate Image";

        preview.style.display = "none";
        $("aiPlaceholder").style.display = "grid";
        $("aiPlaceholder").textContent =
            "The image service did not return a picture.";

        $("saveAI").disabled = true;

        setAIStatus(
            "Generation failed. Try again later or use a different image service."
        );
    };

    setAIStatus("Requesting an image for: " + prompt);

    /*
       The image is loaded directly, not fetched first.
       This is the key fix for browser CORS display issues.
    */
    preview.src = imageURL;
}

async function saveAIImage() {
    if (!currentAIUrl) {
        setAIStatus("Generate an image first.");
        return;
    }

    const button = $("saveAI");
    button.disabled = true;
    button.textContent = "Saving...";

    try {
        let blob = currentAIBlob;

        if (!blob) {
            /*
               Some image services allow direct display but block fetch().
               If that happens, the browser cannot save the remote image
               into IndexedDB from this page without a suitable backend.
            */
            const response = await fetch(currentAIUrl);

            if (!response.ok) {
                throw new Error("Image download failed.");
            }

            blob = await response.blob();

            if (!blob.type.startsWith("image/")) {
                throw new Error("The service did not return an image.");
            }

            currentAIBlob = blob;
        }

        const prompt = $("aiPrompt").value.trim();

        await addPicture({
            name: "AI - " + prompt.slice(0, 65) + ".png",
            blob,
            type: blob.type || "image/png",
            createdAt: Date.now(),
            hidden: false,
            source: "ai",
            prompt
        });

        await refreshPictures();

        setAIStatus("Saved successfully to your gallery.");
        toast("AI picture saved to gallery.");
    } catch (error) {
        console.error("AI save error:", error);

        setAIStatus(
            "The image is displayed, but automatic saving was blocked by " +
            "the image service or browser. A small backend server is needed " +
            "to download and save it reliably."
        );
    } finally {
        button.disabled = false;
        button.textContent = "💾 Save to Gallery";
    }
}

/* =========================================================
   SECRET VAULT
   ========================================================= */

/*
    IMPORTANT:
    This is a basic passcode gate, not strong encryption.
    Hidden images are still stored in this browser's IndexedDB.
    Do not use this for highly sensitive images.
*/

const VAULT_HASH_KEY = "pictureVaultPasscodeHash";

async function hashPasscode(passcode) {
    if (crypto.subtle) {
        const bytes = new TextEncoder().encode(passcode);
        const hash = await crypto.subtle.digest("SHA-256", bytes);

        return Array.from(new Uint8Array(hash))
            .map(byte => byte.toString(16).padStart(2, "0"))
            .join("");
    }

    // Compatibility fallback; not a cryptographic hash.
    let hash = 0;
    for (let i = 0; i < passcode.length; i++) {
        hash = ((hash << 5) - hash) + passcode.charCodeAt(i);
        hash |= 0;
    }
    return "fallback-" + hash;
}

function updateSecretPanel() {
    const savedHash = localStorage.getItem(VAULT_HASH_KEY);

    $("secretSetup").style.display = savedHash ? "none" : "block";
    $("secretUnlock").style.display =
        savedHash && !vaultUnlocked ? "block" : "none";
    $("secretContent").style.display = vaultUnlocked ? "block" : "none";

    renderSecretGallery();
}

$("createVaultBtn").addEventListener("click", async () => {
    const passcode = $("newPasscode").value;
    const confirmation = $("confirmPasscode").value;

    if (passcode.length < 4) {
        $("secretStatus").textContent =
            "Use a passcode with at least 4 characters.";
        return;
    }

    if (passcode !== confirmation) {
        $("secretStatus").textContent = "The passcodes do not match.";
        return;
    }

    const hash = await hashPasscode(passcode);
    localStorage.setItem(VAULT_HASH_KEY, hash);

    $("newPasscode").value = "";
    $("confirmPasscode").value = "";
    $("secretStatus").textContent = "Secret Vault created.";

    toast("Secret Vault created.");
    updateSecretPanel();
});

$("unlockVaultBtn").addEventListener("click", async () => {
    const passcode = $("vaultPasscode").value;
    const savedHash = localStorage.getItem(VAULT_HASH_KEY);

    const enteredHash = await hashPasscode(passcode);

    if (!savedHash || enteredHash !== savedHash) {
        $("secretStatus").textContent = "Incorrect passcode.";
        return;
    }

    vaultUnlocked = true;
    $("vaultPasscode").value = "";
    $("secretStatus").textContent = "Vault unlocked.";

    updateSecretPanel();
    toast("Secret Vault unlocked.");
});

$("lockVaultBtn").addEventListener("click", () => {
    vaultUnlocked = false;
    updateSecretPanel();
    $("secretStatus").textContent = "Vault locked.";
    toast("Secret Vault locked.");
});

/* =========================================================
   STARTUP
   ========================================================= */

async function initializeApp() {
    try {
        db = await openDatabase();

        await refreshPictures();
        updateSecretPanel();

        console.log("Picture Vault is ready.");
    } catch (error) {
        console.error("Startup error:", error);

        alert(
            "Picture Vault could not open its database. " +
            "Try opening this file in a modern browser."
        );
    }
}

initializeApp();
</script>

